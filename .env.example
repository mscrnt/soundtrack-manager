# Copy to .env and edit. Never commit .env.
# Paths below are HOST paths. Inside the container they are always /downloads and /data.

# Image tag for `docker compose pull` (a release such as 0.1.0, or latest)
APP_VERSION=latest

# ---- Web UI ---------------------------------------------------------------
# 127.0.0.1 = this computer only (default). 0.0.0.0 = reachable on your network
# (the app refuses to start then unless WEB_PASSWORD is set).
WEB_BIND=127.0.0.1
WEB_PORT=8080
WEB_USERNAME=admin
# Prefer a secret file: put the password in ./secrets/web_password
# WEB_PASSWORD=

# ---- Host directories ------------------------------------------------------
# Windows (Docker Desktop):  DOWNLOAD_DIR=D:/Music/Soundtracks
# Linux / macOS:              DOWNLOAD_DIR=/home/me/Music/Soundtracks
# Unraid:                     DOWNLOAD_DIR=/mnt/user/media/soundtracks  DATA_DIR=/mnt/user/appdata/soundtrack-manager
DOWNLOAD_DIR=./downloads
DATA_DIR=./data
SECRETS_DIR=./secrets
# Container user. Unraid usually uses PUID=99 PGID=100.
PUID=1000
PGID=1000

# ---- Downloads ---------------------------------------------------------------
PREFERRED_FORMAT=flac          # flac (falls back to mp3 when an album has none) or mp3
MAX_CONCURRENT_DOWNLOADS=2     # albums downloaded at the same time, 1-8
FOLDER_TEMPLATE={platform}/{album}
WORKER_ENABLED=true            # false = the web UI only queues; run `python main.py download` yourself

# ---- Library ------------------------------------------------------------------
# Extra folders to scan besides the download folder (container paths, comma-separated).
# Mount them in compose.yaml first, e.g. /path/to/Soundtracks:/library:ro
# LIBRARY_EXTRA_DIRS=/library

# ---- Politeness / reliability -------------------------------------------------
REQUEST_DELAY_SECONDS=1.5      # minimum gap between site page requests (>= 0.5)
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=4                  # for timeouts, 429 and 5xx; uses exponential backoff
RETRY_BACKOFF_SECONDS=2
CACHE_TTL_HOURS=24             # how long search/browse results are reused before refetching
DISCOVER_MAX_PAGES=20          # cap on 500-album browse pages per platform

# ---- Site access ------------------------------------------------------------------
# auto         = plain HTTP; if the site shows a Cloudflare check, switch to FlareSolverr,
#                then the browser session if FlareSolverr can't be reached
# flaresolverr = always go through FlareSolverr
# browser      = always use the Playwright browser profile
# http         = plain HTTP only
FETCH_MODE=auto
# FlareSolverr runs as its own container in compose.yaml and is ON by default.
# Leave unset to use it. Set it empty (FLARESOLVERR_URL=) to disable it. Outside Docker
# the default is http://127.0.0.1:8191.
# FLARESOLVERR_URL=http://flaresolverr:8191
FLARESOLVERR_TIMEOUT_SECONDS=60
TZ=UTC
BROWSER_HEADLESS=true
# Chromium's own sandbox needs extra kernel permissions in Docker; the container is the boundary.
BROWSER_SANDBOX=false

# Optional khinsider account. Preferred: put the password in ./secrets/khinsider_password
# (one line, file never committed). Setting it here also works.
# KHINSIDER_USERNAME=
# KHINSIDER_PASSWORD=

# ---- Logging -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# ---- Optional AI-assisted discovery (milestone 8; not needed for normal use) -----------
# Any OpenAI-compatible local server, e.g. Ollama or LM Studio.
# LLM_ENDPOINT=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.1:8b
# Only if your server needs a key. Prefer the file ./secrets/llm_api_key.
# LLM_API_KEY=
